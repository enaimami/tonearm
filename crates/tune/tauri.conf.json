{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tune",
  "version": "0.0.1",
  "identifier": "dev.tune.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "tune",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
